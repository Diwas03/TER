# Export these variables into your process; .env files are not loaded automatically.
TER_THRESHOLD=126
TER_INTERVAL_SECONDS=15
# Required: inspect the live TER buy-price element and supply a unique CSS selector.
# Do not target wallet balance, sell price, a historical quote, or an order total.
TER_PRICE_SELECTOR=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_TO=
# Approved WhatsApp template for alerts outside the 24-hour customer-service window.
# Template variable 1 = observed price, variable 2 = threshold.
TWILIO_CONTENT_SID=

# Optional private Vercel status dashboard
DASHBOARD_URL=
MONITOR_API_TOKEN=

# Cloud worker only: private exported browser session (never commit a real value).
TER_BROWSER_SESSION_JSON=
# Set this if the live Buy price appears on a different TER page.
TER_URL=https://ter.bt/portal/dashboard/trade/buy

# Supabase price history (collector only; never publish the service-role key)
SUPABASE_URL=https://figymesgyoritaokpwug.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
